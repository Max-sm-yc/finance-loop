{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Finance Loop diagnosis proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_type",
    "candidate_source_ids",
    "proposed_category",
    "confidence",
    "rationale",
    "missing_evidence",
    "question",
    "policy_version"
  ],
  "properties": {
    "issue_type": {
      "type": "string",
      "enum": ["unknown_item", "ambiguous_transaction", "balance_mismatch", "unsupported_activity"]
    },
    "candidate_source_ids": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1 }
    },
    "proposed_category": {
      "type": ["string", "null"],
      "enum": ["inventory_item", "service_revenue", "cash_deposit", "purchase", "pay", "misc_spend", "transfer", "refund", "exclude", null]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "missing_evidence": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "question": { "type": ["string", "null"], "maxLength": 500 },
    "policy_version": { "type": "string", "minLength": 1 }
  }
}
