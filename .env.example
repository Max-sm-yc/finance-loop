# Server-side settings for the production web/API and workers.
# Keep secrets in the deployment secret store; never prefix them NEXT_PUBLIC.
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_OAUTH_REDIRECT_URI=
# Base64-encoded 32-byte AES key, separate from the Supabase service key.
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Browser Auth and RLS reads use only these public values. Set the browser key
# to the same Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-luna
# Enforce a durable per-organization budget through database reservations.
# Agent output setting; accepted range ends at 3000 tokens.
OPENROUTER_MAX_OUTPUT_TOKENS=700
# Older API receipt extractor output setting; accepted range ends at 3000 tokens.
RECEIPT_AGENT_MAX_OUTPUT_TOKENS=900
# Worker agent cap for diagnosis and supplier receipt extraction; budget reservations apply.
PURCHASE_RECEIPT_MAX_OUTPUT_TOKENS=1400

# Inventory and product analytics are enabled in this release.
INVENTORY_TRACKING_ENABLED=true
PRODUCT_ANALYTICS_ENABLED=true
