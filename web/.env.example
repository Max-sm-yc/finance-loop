NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only values. Keep these out of NEXT_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SQUARE_ENVIRONMENT=sandbox
SQUARE_API_VERSION=2026-09-16
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=
SQUARE_OAUTH_REDIRECT_URI=
# Base64-encoded 32-byte key, separate from the Supabase secret key.
SQUARE_TOKEN_ENCRYPTION_KEY=
OPENROUTER_API_KEY=
# General-purpose chat model. Jev is pinned separately for inventory matching.
OPENROUTER_MODEL=openai/gpt-6-luna
# Agent output setting; accepted range ends at 3000 tokens.
OPENROUTER_MAX_OUTPUT_TOKENS=700
# OPENROUTER_API_KEY also authenticates on-demand Jev receipt inventory matching.
# Receipt extractor output setting; accepted range ends at 3000 tokens.
RECEIPT_AGENT_MAX_OUTPUT_TOKENS=900
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# Server-side feature flags; organization flag defaults are enabled by migration 202610020006.
INVENTORY_TRACKING_ENABLED=true
PRODUCT_ANALYTICS_ENABLED=true
